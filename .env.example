# Claude Code Gateway - Environment Configuration
# Copy to .env and fill in your API keys

# Server
GATEWAY_PORT=8787
GATEWAY_HOST=127.0.0.1
GATEWAY_LOG_LEVEL=INFO

# Provider API Keys (only set keys for providers you use)
# Get keys from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api

# Get keys from: https://console.groq.com/keys
GROQ_API_KEY=gsk-your-key-here

# Get keys from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# NVIDIA NIM (self-hosted or cloud)
# NIM_BASE_URL=http://localhost:8000
# NIM_API_KEY=your-nim-key

# Get keys from: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your-mistral-key

# Opencode Bridge (one instance per provider, managed externally)
# OPENCODE_BRIDGE_ENDPOINTS={"groq":"http://localhost:5001","gemini":"http://localhost:5002","mistral":"http://localhost:5003"}

# Discovery
DISCOVERY_CACHE_TTL=300
# DISCOVERY_CACHE_PATH=~/.claude/cache/gateway-models.json

# Timeouts
REQUEST_TIMEOUT=600
CONNECT_TIMEOUT=10
KEEPALIVE_INTERVAL=30

# Rate Limiting (local enforcement for free tiers)
GEMINI_RPM=15
MISTRAL_RPM=500

# Fallback
MAX_FALLBACK_ATTEMPTS=3