#!/usr/bin/env bash
# gw — frictionless dispatch of a task to a FREE gateway engine.
#
# The orchestrator (Claude, on the subscription) launches this as a background
# Bash task; the reasoning + tool-use runs on a free gateway engine ($0 quota),
# and the transcript + answer stream to the task's output file. gw_agent.py walks
# a free-engine chain internally, so a 429 on one engine just falls through to the
# next — the spawn "just works".
#
#   gw "list the functions defined in gateway/router.py"   # reader: read_file/grep only, no shell
#   gw -w "count the .py files under gateway/ with bash"    # worker: needs shell (bash) or writes
#   gw -m claude-groq-llama3 "..."                          # prefer an engine (still falls back)
#
set -uo pipefail
ROOT="/Users/gustavoschneiter/Documents/Omnirouter"
PY="$ROOT/.venv/bin/python"; [ -x "$PY" ] || PY="python3"

mode="reader"
model="claude-mistral-large"   # primary; gw_agent falls back to the free chain
while getopts "wm:" opt; do
  case "$opt" in
    w) mode="worker" ;;
    m) model="$OPTARG" ;;
    *) echo "usage: gw [-w] [-m engine] \"task\"" >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))
task="$*"
[ -n "$task" ] || { echo "usage: gw [-w] [-m engine] \"task\"" >&2; exit 2; }

exec "$PY" "$ROOT/scripts/gw_agent.py" --model "$model" --mode "$mode" --cwd "$ROOT" --task "$task"
